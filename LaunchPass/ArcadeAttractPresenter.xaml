<UserControl x:Class="RetroPass.ArcadeAttractPresenter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="False">
    <Grid x:Name="MuseumRoot" Background="#FA101522">
        <Image x:Name="Entrance" Stretch="UniformToFill" Opacity="0.14" />
        <Canvas x:Name="NeonGrid" IsHitTestVisible="False" />
        <Ellipse Width="440" Height="2" Fill="#FF9A3D" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,54" />
        <Grid x:Name="Exhibit" Margin="64,48">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Image x:Name="Logo" Stretch="Uniform" MaxWidth="650" MaxHeight="280" />
                <TextBlock x:Name="TitleFallback" Foreground="#F4F5ED" FontSize="46" FontWeight="Bold"
                           TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,22,0,0">
                <TextBlock x:Name="TitleLabel" Foreground="#F4F5ED" FontSize="22" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailLabel" Foreground="#32D8E8" FontSize="16" TextAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
